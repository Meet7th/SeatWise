{
  "name": "seatwise",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @seatwise/web dev",
    "dev:server": "pnpm --filter @seatwise/server dev",
    "dev:all": "concurrently \"pnpm dev:server\" \"pnpm dev\"",
    "start": "node scripts/start.mjs",
    "build": "pnpm --filter @seatwise/web build && pnpm --filter @seatwise/server build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
