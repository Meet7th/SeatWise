# Database (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/seatwise
# Database (SQLite - 本地开发推荐，无需安装 MySQL)
# DATABASE_URL=file:./seatwise.db
# Database (PostgreSQL - Supabase 云端部署)
# DATABASE_URL=postgresql://postgres.[项目ID]:[密码]@aws-0-[区域].pooler.supabase.com:6532/postgres

# Redis (可选，当前版本未使用)
# REDIS_URL=redis://localhost:6379

JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
PORT=3000
