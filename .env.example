# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws

# Backend
# MySQL 模式（需要安装 MySQL）
DATABASE_URL=mysql://root:password@localhost:3306/seatwise
# SQLite 模式（推荐，无需安装 MySQL，直接使用 start.bat 启动）
# DATABASE_URL=file:./seatwise.db

# Redis（可选，当前版本未使用）
# REDIS_URL=redis://localhost:6379

JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key

# WeChat OAuth
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WECHAT_REDIRECT_URI=http://localhost:3000/auth/wechat/callback

# QQ OAuth
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key
QQ_REDIRECT_URI=http://localhost:3000/auth/qq/callback

# SMS (Aliyun)
SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
SMS_SIGN_NAME=智座
SMS_TEMPLATE_CODE=SMS_123456

# Email (SMTP)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@seatwise.com

# Frontend URL
FRONTEND_URL=http://localhost:5173
