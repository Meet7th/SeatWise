# Stage 1: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy workspace config
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

# Allow pnpm build scripts and hoist dependencies for Docker
RUN echo -e "onlyBuiltDependencies=*\nshamefully-hoist=true" > .npmrc

# Install dependencies
RUN pnpm install

# Copy source code (node_modules already installed by pnpm)
COPY packages/shared/ ./packages/shared/
COPY apps/web/ ./apps/web/

# Remove any local node_modules that may have been copied (pnpm manages them at root)
RUN rm -rf apps/web/node_modules apps/server/node_modules packages/shared/node_modules

# Build frontend from workspace root
RUN pnpm --filter @seatwise/web build

# Stage 2: Serve
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
